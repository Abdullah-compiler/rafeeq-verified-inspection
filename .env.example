# Copy to .env at the repository root. Never commit the real .env.
OPENROUTER_API_KEY=

# Only free tool-calling model IDs are allowed by this demo.
# Free-model availability and account quotas can change.
AGENT_PROVIDER=openrouter
AGENT_MODEL=nvidia/nemotron-3.5-lightning:free
AGENT_SMALL_MODEL=liquid/lfm-2.5-2.6b:free
AGENT_FALLBACKS=liquid/lfm-2.5-2.6b:free

# Separate random LOCAL SERVICE credentials, not your OpenRouter key.
# Generate two distinct values locally, e.g. with Python secrets.token_urlsafe(32).
RAFEEQ_USER_TOKEN=
RAFEEQ_OFFICER_TOKEN=
